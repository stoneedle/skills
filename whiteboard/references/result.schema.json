{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["user_text", "visualization", "verification"],
  "properties": {
    "user_text": {
      "type": "string",
      "minLength": 1
    },
    "visualization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["needed", "html"],
      "properties": {
        "needed": {
          "type": "boolean"
        },
        "html": {
          "type": ["string", "null"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "needed": { "const": true }
            },
            "required": ["needed"]
          },
          "then": {
            "properties": {
              "html": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "html": { "type": "null" }
            }
          }
        }
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claims"],
      "properties": {
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["statement", "evidence"],
            "properties": {
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "symbol", "reason"],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "symbol": {
                      "type": "string",
                      "minLength": 1
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "minItems": 1
              }
            }
          }
        }
      }
    }
  }
}
